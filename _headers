# Cloudflare Pages : en-têtes des fichiers
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/config-site.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
/manifest.webmanifest
  Cache-Control: no-cache
/icons/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Collection d'assets (AppMod / Asset Library) : lisible par les autres applis, jamais exécutable
/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox

# Images de l'appli listées dans sa collection d'assets : lisibles par Asset Library et AppMod

# Version automatique (lue par AppMod)
/version.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
